# Anthropic (required)
ANTHROPIC_API_KEY=

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ElevenLabs (optional — app falls back to browser TTS if missing)
ELEVENLABS_API_KEY=
MADRID_ELENA_VOICE_ID=
MADRID_MIGUEL_VOICE_ID=
MEXICO_SOFIA_VOICE_ID=
MEXICO_CARLOS_VOICE_ID=
BUENOS_AIRES_VALENTINA_VOICE_ID=
BUENOS_AIRES_RODRIGO_VOICE_ID=

# App
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database — defaults to ./data/lengua.db
# On Railway, set this to /data/lengua.db and mount a volume at /data
DATABASE_PATH=
